PORT=5000
# Local Docker: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=hostel_laundry postgres:16
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/hostel_laundry
# Use a long random value in production (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_SECRET=change_me_in_production
CLIENT_ORIGIN=http://localhost:5173
# Password given to every seeded account by `npm run seed`
SEED_PASSWORD=password123
